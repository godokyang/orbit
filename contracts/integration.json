{
  "contract": "orbit-integration",
  "version": "2.0.0",
  "major": 2,
  "description": "Machine-readable form of contracts/integration.md for the DSH Orbit integration. 2.0 removes the OMP-era commands and fields. `orbit capabilities --json` serves these capabilities and the contract test reads commands/status fields.",
  "status_values": ["starting", "running", "complete", "paused", "needs_user", "failed", "stop_unconfirmed"],
  "terminal_status_values": ["complete", "paused", "needs_user", "failed", "stop_unconfirmed"],
  "commands": {
    "capabilities": {
      "invocation": "orbit capabilities --json",
      "stdout_fields": ["integration_contract.version", "integration_contract.major", "orbit.version", "capabilities"]
    },
    "launch": {
      "invocation": "orbit launch --json [--profile P] [--home DIR] [--project DIR]",
      "stdout_fields": ["kind", "contract", "profile", "cwd", "argv", "env", "stdin", "control_socket", "ready"]
    },
    "status": {
      "invocation": "orbit status [TASK] --json [--project DIR]",
      "stdout_fields": ["ok", "taskId", "status", "inputVersion", "artifactRoot", "checksInFlight", "stop", "stopConfirmation", "completionInvalidation", "members", "workUnits", "checks", "openFindings", "openDisputes"]
    },
    "events": {
      "invocation": "orbit events [TASK] --after CURSOR [--json] [--project DIR]",
      "stdout_fields": ["taskId", "events", "next_cursor"],
      "note": "next_cursor is opaque base64url and must be passed back unchanged."
    },
    "sessions": {
      "invocation": "orbit sessions [TASK] --json [--project DIR]",
      "stdout_fields": ["as_of_seq", "root", "members"],
      "note": "Read-only projection. state=unavailable means no live or archived session, not an empty live session."
    },
    "prompt": {
      "invocation": "orbit prompt [TASK] --message TEXT --json [--project DIR]",
      "stdout_fields": ["ok", "accepted", "taskId", "messageId"],
      "note": "Injects a native user message into the bound Root session. accepted is not model adoption."
    },
    "abort": {
      "invocation": "orbit abort [TASK] --json [--project DIR]",
      "stdout_fields": ["ok", "taskId", "scope", "aborted"],
      "note": "Aborts the bound session only; it does not stop the task or prove completion."
    },
    "questions": {
      "invocation": "orbit questions [TASK] --json [--project DIR]",
      "stdout_fields": ["questions"]
    },
    "answer": {
      "invocation": "orbit answer [TASK] --question ID --selected A,B [--custom TEXT] --json [--project DIR]",
      "stdout_fields": ["question"],
      "note": "Requires a live host; an answer never implies the model adopted it."
    },
    "status_by_external_ref": {
      "invocation": "orbit status --external-ref REF --json [--project DIR]",
      "stdout_fields": ["tasks"],
      "note": "Exact match over all tasks, newest first; success always returns a tasks array, no match exits 0."
    },
    "stop": {
      "invocation": "orbit stop [TASK] --json [--project DIR]",
      "stdout_fields": ["ok", "taskId", "status", "fence", "stop", "stopConfirmation"],
      "note": "fence=armed is not confirmation; only stopConfirmation.confirmed=true means stopped."
    },
    "export": {
      "invocation": "orbit export [TASK] --output FILE --json [--project DIR]",
      "stdout_fields": ["taskId", "bytes", "output", "files"]
    }
  },
  "status_fields": {
    "ok": "boolean",
    "taskId": "string",
    "status": "status_values",
    "inputVersion": "integer",
    "artifactRoot": "absolute path",
    "checksInFlight": "integer|null",
    "stop": "string|omitted",
    "stopConfirmation": "object|omitted",
    "completionInvalidation": "object|null|omitted",
    "members": "array",
    "workUnits": "array",
    "checks": "array",
    "externalRefs": "string[]|omitted",
    "modelAuthorization": "object|null|omitted",
    "openFindings": "string[]",
    "openDisputes": "string[]|omitted"
  },
  "session_fields": {
    "as_of_seq": "integer",
    "root": "session_projection",
    "members": "session_projection[]"
  },
  "session_projection": {
    "session_id": "string",
    "state": "available|unavailable",
    "as_of_seq": "integer",
    "visible_text": "array",
    "user_messages": "array",
    "activities": "array",
    "questions": "array",
    "deliveries": "array",
    "gaps": "array|omitted",
    "archive_segments": "integer|omitted"
  },
  "capabilities": {
    "launch": { "since": "2.0.0", "stdin": "keep-open", "process_owner": "caller" },
    "headless": { "since": "2.0.0", "spec_version": 1, "env": ["ORBIT_BOOTSTRAP", "ORBIT_BOOTSTRAP_RESULT"] },
    "status": { "since": "2.0.0" },
    "status_by_external_ref": { "since": "2.0.0", "max_refs": 8, "max_length": 256 },
    "events": { "since": "2.0.0", "cursor": "opaque" },
    "sessions": { "since": "2.0.0", "visible_text": true, "user_messages": true, "activities": true, "questions": true, "deliveries": true },
    "questions": { "since": "2.0.0" },
    "answer": { "since": "2.0.0" },
    "prompt": { "since": "2.0.0" },
    "abort": { "since": "2.0.0", "scope": "session" },
    "stop": { "since": "2.0.0", "receipt": "evidence" },
    "export": { "since": "2.0.0", "self_contained": true }
  },
  "removed_in_2_0": [
    "provider=omp",
    "session_file and byte offsets",
    "conversation and messages commands",
    "events seq-only response without next_cursor",
    "1.x status field names"
  ]
}
