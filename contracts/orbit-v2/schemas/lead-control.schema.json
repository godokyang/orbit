{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.local/contracts/orbit-v2/schemas/lead-control.schema.json",
  "title": "Orbit v2 Slice 2 control registry and lead checkpoint contracts",
  "$defs": {
    "LeadControlRegistry": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_epoch",
        "project_id",
        "object_type",
        "lead_control_id",
        "genesis_checkpoint_ref",
        "writer_authority_provenance",
        "owned_task_refs",
        "content_digest"
      ],
      "properties": {
        "schema_version": {"const": "orbit-lead-control-registry-v1"},
        "protocol_epoch": {"const": "orbit-v2"},
        "project_id": {"type": "string", "pattern": "^oproj_[a-z0-9][a-z0-9_-]{7,63}$"},
        "object_type": {"const": "lead_control_registry"},
        "lead_control_id": {"type": "string", "pattern": "^olcontrol_[a-z0-9][a-z0-9_-]{7,95}$"},
        "genesis_checkpoint_ref": {"$ref": "#/$defs/LeadCheckpointRef"},
        "writer_authority_provenance": {"$ref": "#/$defs/WriterAuthorityProvenance"},
        "owned_task_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/TaskRef"}
        },
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "LeadCheckpoint": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol_epoch",
        "project_id",
        "object_type",
        "lead_checkpoint_id",
        "lead_control_id",
        "is_genesis",
        "predecessor_lead_checkpoint_ref",
        "project_policy_revision_ref",
        "lead_agent_instance_ref",
        "active_lead_session_ref",
        "lead_runtime_subject_ref",
        "lead_runtime_subject_assertion_digest",
        "logical_lead_refs",
        "task_queue",
        "active_task_ref",
        "selected_work_unit_ref",
        "current_or_terminal_attempt_ref",
        "assessments",
        "delivery_progress",
        "assurance_progress",
        "effective_budget_bindings",
        "effective_verification_plan_digest",
        "closure_basis_digest",
        "lead_decision",
        "reconcile_trigger",
        "next_trigger",
        "writer_authority_provenance",
        "content_digest"
      ],
      "properties": {
        "schema_version": {"const": "orbit-lead-checkpoint-v1"},
        "protocol_epoch": {"const": "orbit-v2"},
        "project_id": {"type": "string", "pattern": "^oproj_[a-z0-9][a-z0-9_-]{7,63}$"},
        "object_type": {"const": "lead_checkpoint"},
        "lead_checkpoint_id": {
          "type": "string",
          "pattern": "^olcheckpoint_[a-z0-9][a-z0-9_-]{7,95}$"
        },
        "lead_control_id": {"type": "string", "pattern": "^olcontrol_[a-z0-9][a-z0-9_-]{7,95}$"},
        "is_genesis": {"type": "boolean"},
        "predecessor_lead_checkpoint_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/LeadCheckpointRef"}
          ]
        },
        "project_policy_revision_ref": {"$ref": "#/$defs/PolicyRevisionRef"},
        "lead_agent_instance_ref": {"$ref": "#/$defs/AgentInstanceRef"},
        "active_lead_session_ref": {"$ref": "#/$defs/LeadSessionRef"},
        "lead_runtime_subject_ref": {"type": "string", "minLength": 1},
        "lead_runtime_subject_assertion_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logical_lead_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/LogicalLeadRef"}
        },
        "task_queue": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/TaskRef"}
        },
        "active_task_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/TaskRef"}
          ]
        },
        "selected_work_unit_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/WorkUnitRef"}
          ]
        },
        "current_or_terminal_attempt_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/AttemptRef"}
          ]
        },
        "assessments": {"$ref": "#/$defs/Assessments"},
        "delivery_progress": {"$ref": "#/$defs/Progress"},
        "assurance_progress": {"$ref": "#/$defs/Progress"},
        "task_transfer_acquire": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/TaskAcquire"}
          ]
        },
        "effective_budget_bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/EffectiveBudgetBinding"}
        },
        "budget_adjustment_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "test_budget_adjust": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/BudgetAdjustmentPayload"}
          ]
        },
        "effective_verification_plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "closure_basis_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "wall_clock_fallback": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/WallClockFallback"}
          ]
        },
        "checkpoint_due_observation_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/AuthorityAssertionRef"}
          ]
        },
        "fingerprint_identity_basis": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/FingerprintIdentityBasis"}
          ]
        },
        "fingerprint": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "fingerprint_supporting_provenance": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/FingerprintSupportingProvenance"}
          ]
        },
        "retry_override_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/AuthorizationRecordRef"}
          ]
        },
        "lead_decision": {"$ref": "#/$defs/LeadDecision"},
        "reconcile_trigger": {"$ref": "#/$defs/NextTrigger"},
        "next_trigger": {"$ref": "#/$defs/NextTrigger"},
        "writer_authority_provenance": {"$ref": "#/$defs/WriterAuthorityProvenance"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "LeadCheckpointRef": {
      "type": "object",
      "required": ["lead_checkpoint_id", "content_digest"],
      "properties": {
        "lead_checkpoint_id": {
          "type": "string",
          "pattern": "^olcheckpoint_[a-z0-9][a-z0-9_-]{7,95}$"
        },
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "PolicyRevisionRef": {
      "type": "object",
      "required": ["policy_revision_id", "content_digest"],
      "properties": {
        "policy_revision_id": {"type": "string", "pattern": "^opolicy_[a-z0-9][a-z0-9_-]{7,95}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "AgentInstanceRef": {
      "type": "object",
      "required": ["agent_instance_id"],
      "properties": {
        "agent_instance_id": {"type": "string", "pattern": "^oagent_[a-z0-9][a-z0-9_-]{7,95}$"}
      },
      "additionalProperties": false
    },
    "LeadSessionRef": {
      "type": "object",
      "required": ["lead_session_id", "session_generation"],
      "properties": {
        "lead_session_id": {
          "type": "string",
          "pattern": "^oleadsession_[a-z0-9][a-z0-9_-]{7,95}$"
        },
        "session_generation": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "LogicalLeadRef": {
      "type": "object",
      "required": ["logical_lead_id", "content_digest"],
      "properties": {
        "logical_lead_id": {"type": "string", "pattern": "^olead_[a-z0-9][a-z0-9_-]{7,95}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "TaskRef": {
      "type": "object",
      "required": ["task_id", "task_revision_id", "content_digest"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^otask_[a-z0-9][a-z0-9_-]{7,95}$"},
        "task_revision_id": {"type": "string", "pattern": "^trev_[a-z0-9][a-z0-9_-]{7,95}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "WriterAuthorityProvenance": {
      "type": "object",
      "required": ["policy_revision_ref", "action", "assertion_ref"],
      "properties": {
        "policy_revision_ref": {"$ref": "#/$defs/PolicyRevisionRef"},
        "action": {"enum": ["control.genesis", "control.checkpoint"]},
        "assertion_ref": {"$ref": "#/$defs/AssertionRef"}
      },
      "additionalProperties": false
    },
    "AssertionRef": {
      "type": "object",
      "required": ["assertion_id", "assertion_digest"],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^oassert_[a-z0-9][a-z0-9_-]{7,95}$"},
        "assertion_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "WorkUnitRef": {
      "type": "object",
      "required": ["work_unit_id", "content_digest"],
      "properties": {
        "work_unit_id": {"type": "string", "pattern": "^owu_[a-z0-9][a-z0-9_-]{7,95}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "AttemptRef": {
      "type": "object",
      "required": ["attempt_id", "event_id", "event_digest"],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^oattempt_[a-z0-9][a-z0-9_-]{7,95}$"},
        "event_id": {"type": "string", "pattern": "^oevent_[a-z0-9][a-z0-9_-]{7,95}$"},
        "event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "TaskAcquire": {
      "type": "object",
      "required": ["released_checkpoint_ref", "released_lead_control_id", "task_ref"],
      "properties": {
        "released_checkpoint_ref": {"$ref": "#/$defs/LeadCheckpointRef"},
        "released_lead_control_id": {
          "type": "string",
          "pattern": "^olcontrol_[a-z0-9][a-z0-9_-]{7,95}$"
        },
        "task_ref": {"$ref": "#/$defs/TaskRef"}
      },
      "additionalProperties": false
    },
    "AuthorizationRecordRef": {
      "type": "object",
      "required": ["authorization_record_id", "content_digest"],
      "properties": {
        "authorization_record_id": {
          "type": "string",
          "pattern": "^oauthz_[a-z0-9][a-z0-9_-]{7,95}$"
        },
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "EffectiveBudgetBinding": {
      "type": "object",
      "required": [
        "budget_scope_type",
        "project_policy_revision_ref",
        "source_kind",
        "lead_adjustment_source",
        "user_override_source",
        "effective_test_count",
        "effective_test_code_lines",
        "measurements"
      ],
      "properties": {
        "budget_scope_type": {"enum": ["work_unit_lineage", "task_lineage"]},
        "project_policy_revision_ref": {"$ref": "#/$defs/PolicyRevisionRef"},
        "source_kind": {"enum": ["policy_default", "lead_adjustment", "user_override"]},
        "lead_adjustment_source": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/LeadAdjustmentSource"}
          ]
        },
        "user_override_source": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/UserOverrideSource"}
          ]
        },
        "effective_test_count": {"type": "integer", "minimum": 0},
        "effective_test_code_lines": {"type": "integer", "minimum": 0},
        "measurements": {"$ref": "#/$defs/BudgetMeasurements"}
      },
      "additionalProperties": false
    },
    "LeadAdjustmentSource": {
      "type": "object",
      "required": ["mode", "adjustment_digest", "inherited_checkpoint_ref"],
      "properties": {
        "mode": {"enum": ["current", "inherited"]},
        "adjustment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "inherited_checkpoint_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/LeadCheckpointRef"}
          ]
        }
      },
      "additionalProperties": false
    },
    "UserOverrideSource": {
      "type": "object",
      "required": ["mode", "authorization_record_ref", "origin_consuming_checkpoint_ref"],
      "properties": {
        "mode": {"enum": ["consume", "inherit"]},
        "authorization_record_ref": {"$ref": "#/$defs/AuthorizationRecordRef"},
        "origin_consuming_checkpoint_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/LeadCheckpointRef"}
          ]
        }
      },
      "additionalProperties": false
    },
    "BudgetAdjustmentPayload": {
      "type": "object",
      "required": [
        "budget_scope_type",
        "project_policy_revision_ref",
        "predecessor_lead_checkpoint_ref",
        "predecessor_binding_digest",
        "old_effective_budget",
        "new_effective_budget",
        "supporting_refs"
      ],
      "properties": {
        "budget_scope_type": {"enum": ["work_unit_lineage", "task_lineage"]},
        "project_policy_revision_ref": {"$ref": "#/$defs/PolicyRevisionRef"},
        "predecessor_lead_checkpoint_ref": {"$ref": "#/$defs/LeadCheckpointRef"},
        "predecessor_binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "old_effective_budget": {"$ref": "#/$defs/EffectiveCeiling"},
        "new_effective_budget": {"$ref": "#/$defs/EffectiveCeiling"},
        "supporting_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/SupportingRef"}
        }
      },
      "additionalProperties": false
    },
    "EffectiveCeiling": {
      "type": "object",
      "required": ["test_count", "test_code_lines"],
      "properties": {
        "test_count": {"type": "integer", "minimum": 0},
        "test_code_lines": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "BudgetMeasurements": {
      "type": "object",
      "required": ["test_count", "test_code_lines"],
      "properties": {
        "test_count": {"$ref": "#/$defs/BudgetMeasurement"},
        "test_code_lines": {"$ref": "#/$defs/BudgetMeasurement"}
      },
      "additionalProperties": false
    },
    "BudgetMeasurement": {
      "type": "object",
      "required": ["status", "usage", "source_ref", "unverified_assessment"],
      "properties": {
        "status": {"enum": ["verified", "unverified"]},
        "usage": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "source_ref": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["kind", "id", "digest"],
              "properties": {
                "kind": {"const": "measurement_attestation"},
                "id": {"type": "string", "pattern": "^oassert_[a-z0-9][a-z0-9_-]{7,95}$"},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          ]
        },
        "unverified_assessment": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/UnverifiedAssessment"}
          ]
        }
      },
      "additionalProperties": false
    },
    "UnverifiedAssessment": {
      "type": "object",
      "required": [
        "lead_disposition",
        "lead_reason_code",
        "lead_supporting_refs",
        "review_status",
        "review_gate_evaluation_ref"
      ],
      "properties": {
        "lead_disposition": {
          "enum": [
            "proceed_pending_independent_review",
            "proceed_after_independent_review",
            "replan_after_independent_rejection"
          ]
        },
        "lead_reason_code": {"type": "string", "minLength": 1},
        "lead_supporting_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/SupportingRef"}
        },
        "review_status": {"enum": ["pending", "accepted", "rejected"]},
        "review_gate_evaluation_ref": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["gate_evaluation_id", "content_digest"],
              "properties": {
                "gate_evaluation_id": {
                  "type": "string",
                  "pattern": "^ogeval_[a-z0-9][a-z0-9_-]{7,95}$"
                },
                "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ExactEventRef": {
      "type": "object",
      "required": ["kind", "id", "event_id", "digest"],
      "properties": {
        "kind": {"const": "attempt_event"},
        "id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "pattern": "^oevent_[a-z0-9][a-z0-9_-]{7,95}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "AuthorityAssertionRef": {
      "type": "object",
      "required": ["assertion_id", "assertion_digest"],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^oassert_[a-z0-9][a-z0-9_-]{7,95}$"},
        "assertion_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "WallClockFallback": {
      "type": "object",
      "required": ["source_kind", "deadline", "source_ref", "schedule_basis_ref"],
      "properties": {
        "source_kind": {"enum": ["policy", "authorization_record"]},
        "deadline": {"type": "string", "minLength": 1},
        "source_ref": {
          "type": "object",
          "required": ["id", "content_digest"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "schedule_basis_ref": {"$ref": "#/$defs/ExactEventRef"}
      },
      "additionalProperties": false
    },
    "FingerprintIdentityBasis": {
      "type": "object",
      "required": [
        "canonicalization_version",
        "scope",
        "category",
        "failure_code",
        "finding_ref",
        "stable_signal_identity"
      ],
      "properties": {
        "canonicalization_version": {"const": "orbit-fingerprint-v1"},
        "scope": {
          "type": "object",
          "required": ["task_revision_ref", "work_unit_ref"],
          "properties": {
            "task_revision_ref": {"$ref": "#/$defs/TaskRef"},
            "work_unit_ref": {"$ref": "#/$defs/WorkUnitRef"}
          },
          "additionalProperties": false
        },
        "category": {"enum": ["finding", "test", "rule", "check"]},
        "failure_code": {"type": "string", "minLength": 1},
        "finding_ref": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["finding_id", "content_digest"],
              "properties": {
                "finding_id": {"type": "string", "pattern": "^ofinding_[a-z0-9][a-z0-9_-]{7,95}$"},
                "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          ]
        },
        "stable_signal_identity": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": [
                "test_or_check_id",
                "signal_subject_id",
                "normalized_failure_code"
              ],
              "properties": {
                "test_or_check_id": {"type": "string", "minLength": 1},
                "signal_subject_id": {"type": "string", "minLength": 1},
                "normalized_failure_code": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "FingerprintSupportingProvenance": {
      "type": "object",
      "required": [
        "terminal_attempt_ref",
        "outcome_refs",
        "authoring_checkpoint_ref",
        "prior_attempt_chain"
      ],
      "properties": {
        "terminal_attempt_ref": {"$ref": "#/$defs/AttemptRef"},
        "outcome_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/SupportingRef"}
        },
        "authoring_checkpoint_ref": {"$ref": "#/$defs/LeadCheckpointRef"},
        "prior_attempt_chain": {
          "type": "array",
          "items": {"$ref": "#/$defs/AttemptRef"}
        }
      },
      "additionalProperties": false
    },
    "Assessments": {
      "type": "object",
      "required": ["task_queue", "active_mainline", "work_graph_branches", "current_attempt"],
      "properties": {
        "task_queue": {"$ref": "#/$defs/AssessmentLayer"},
        "active_mainline": {"$ref": "#/$defs/AssessmentLayer"},
        "work_graph_branches": {"$ref": "#/$defs/AssessmentLayer"},
        "current_attempt": {"$ref": "#/$defs/AssessmentLayer"}
      },
      "additionalProperties": false
    },
    "AssessmentLayer": {
      "type": "object",
      "required": ["status", "rationale", "basis_projection", "supporting_refs"],
      "properties": {
        "status": {"enum": ["ok", "warning", "blocked", "none"]},
        "rationale": {"type": "string", "minLength": 1},
        "basis_projection": {
          "enum": ["task_queue", "active_task_ref", "selected_work_unit_ref", "current_or_terminal_attempt_ref"]
        },
        "supporting_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/SupportingRef"}
        }
      },
      "additionalProperties": false
    },
    "SupportingRef": {
      "type": "object",
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {
          "enum": [
            "work_unit",
            "task_revision",
            "evidence_record",
            "finding",
            "finding_resolution",
            "gate_evaluation",
            "lead_checkpoint",
            "change_thesis",
            "attempt_event",
            "agent_event",
            "rule_resolution"
          ]
        },
        "id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "event_id": {"type": "string", "pattern": "^oevent_[a-z0-9][a-z0-9_-]{7,95}$"}
      },
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "required": [
        "change",
        "rationale",
        "predecessor_lead_checkpoint_ref",
        "measured_terminal_attempt_ref",
        "substantive_change_kinds",
        "supporting_refs"
      ],
      "properties": {
        "change": {"enum": ["not_assessed", "changed", "unchanged"]},
        "rationale": {"type": "string", "minLength": 1},
        "predecessor_lead_checkpoint_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/LeadCheckpointRef"}
          ]
        },
        "measured_terminal_attempt_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/AttemptRef"}
          ]
        },
        "substantive_change_kinds": {
          "type": "array",
          "items": {"enum": ["thesis", "agent_context", "scope", "verification_plan"]}
        },
        "supporting_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/SupportingRef"}
        }
      },
      "additionalProperties": false
    },
    "LeadDecision": {
      "type": "object",
      "required": ["state", "action", "reason"],
      "properties": {
        "state": {
          "enum": ["completed", "blocked", "frozen", "needs_user"]
        },
        "action": {"enum": ["establish", "continue", "dispatch", "replan", "switch", "freeze", "escalate", "release", "suspend", "acquire"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "NextTrigger": {
      "type": "object",
      "required": ["event", "reason"],
      "properties": {
        "event": {
          "enum": [
            "genesis",
            "attempt_created",
            "attempt_terminal",
            "successor_before",
            "dispatch_before",
            "thesis_change",
            "scope_change",
            "finding_change",
            "gate_change",
            "task_revision_change",
            "session_change",
            "context_change",
            "authority_change",
            "dependency_change",
            "budget_change",
            "task_release",
            "task_suspend",
            "task_acquire",
            "checkpoint_due"
          ]
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
