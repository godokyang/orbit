{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.local/contracts/orbit-v2/schemas/evidence.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "$defs": {
    "ArtifactClaim": {
      "type": "object",
      "required": ["artifact_ref", "artifact_kind", "content_digest", "paths"],
      "properties": {
        "artifact_ref": {"type": "string", "pattern": "^artifact://[^/]+(?:/[^/]+)*$"},
        "artifact_kind": {"enum": ["change", "verification", "report"]},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "required": ["artifact_ref", "content_digest"],
      "properties": {
        "artifact_ref": {"type": "string", "pattern": "^artifact://[^/]+(?:/[^/]+)*$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "protocol_epoch",
    "project_id",
    "evidence_record_id",
    "record_kind",
    "task_id",
    "task_revision_id",
    "work_unit_id",
    "attempt_id",
    "submitted_rule_resolution_id",
    "accepted",
    "acceptance_recorded_at",
    "supersedes_evidence_record_id",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "orbit-evidence-v2"},
    "protocol_epoch": {"const": "orbit-v2"},
    "project_id": {"type": "string", "pattern": "^oproj_[a-z0-9][a-z0-9_-]{7,63}$"},
    "evidence_record_id": {"type": "string", "pattern": "^oevr_[a-z0-9][a-z0-9_-]{7,95}$"},
    "record_kind": {"enum": ["implementation", "evaluator_submission"]},
    "task_id": {"type": "string", "pattern": "^otask_[a-z0-9][a-z0-9_-]{7,95}$"},
    "task_revision_id": {"type": "string", "pattern": "^trev_[a-z0-9][a-z0-9_-]{7,95}$"},
    "work_unit_id": {"type": "string", "pattern": "^owu_[a-z0-9][a-z0-9_-]{7,95}$"},
    "attempt_id": {"type": "string", "pattern": "^oattempt_[a-z0-9][a-z0-9_-]{7,95}$"},
    "submitted_rule_resolution_id": {"type": "string", "pattern": "^rr-sha256-[0-9a-f]{64}$"},
    "accepted": {"const": true},
    "acceptance_recorded_at": {"type": "string", "minLength": 1},
    "implementation_check": {
      "type": "object",
      "required": [
        "change_thesis_ref",
        "scope_match",
        "acceptance_results",
        "evidence_requirement_results",
        "change_thesis_status",
        "changed_paths",
        "verification_refs",
        "assumptions_changed",
        "known_gaps"
      ],
      "properties": {
        "change_thesis_ref": {"$ref": "task-work.schema.json#/$defs/ThesisRef"},
        "scope_match": {
          "type": "object",
          "required": ["status", "evidence_refs"],
          "properties": {
            "status": {"const": "pass"},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/ArtifactRef"}
            }
          },
          "additionalProperties": false
        },
        "acceptance_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["acceptance_id", "status", "evidence_refs"],
            "properties": {
              "acceptance_id": {
                "type": "string",
                "pattern": "^acc_[a-z0-9][a-z0-9_-]{2,95}$"
              },
              "status": {"const": "pass"},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/ArtifactRef"}
              }
            },
            "additionalProperties": false
          }
        },
        "evidence_requirement_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidence_requirement_id", "status", "evidence_refs"],
            "properties": {
              "evidence_requirement_id": {
                "type": "string",
                "pattern": "^evreq_[a-z0-9][a-z0-9_-]{2,95}$"
              },
              "status": {"const": "pass"},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/ArtifactRef"}
              }
            },
            "additionalProperties": false
          }
        },
        "change_thesis_status": {
          "type": "object",
          "required": ["status", "evidence_refs"],
          "properties": {
            "status": {"const": "supported"},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/ArtifactRef"}
            }
          },
          "additionalProperties": false
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verification_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ArtifactRef"}
        },
        "assumptions_changed": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string", "minLength": 1}
        },
        "known_gaps": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "submission_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ArtifactClaim"}
    },
    "supersedes_evidence_record_id": {
      "oneOf": [
        {"type": "string", "pattern": "^oevr_[a-z0-9][a-z0-9_-]{7,95}$"},
        {"type": "null"}
      ]
    },
    "related_evidence_record_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^oevr_[a-z0-9][a-z0-9_-]{7,95}$"}
    },
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"record_kind": {"const": "implementation"}}},
      "then": {"required": ["implementation_check", "submission_artifact_refs"]}
    },
    {
      "if": {"properties": {"record_kind": {"const": "evaluator_submission"}}},
      "then": {
        "required": ["submission_artifact_refs"],
        "not": {"required": ["implementation_check"]}
      }
    }
  ],
  "additionalProperties": false
}
