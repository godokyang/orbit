{
  "name": "@orbit/bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orbit DSH profile bundle: controlled rows, approval/sandbox policy and the Orbit host plugin.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./profiles/orbit-checker.patch.yml": "./profiles/orbit-checker.patch.yml",
    "./package.json": "./package.json",
    "./profiles/orbit-app.patch.yml": "./profiles/orbit-app.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "profiles"
  ],
  "dependencies": {
    "@orbit/dsh-host": "workspace:*"
  }
}
