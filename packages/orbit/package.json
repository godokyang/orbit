{
  "name": "@zeen/orbit",
  "version": "0.1.0",
  "type": "module",
  "description": "Single Orbit DSH bundle: host service, CLI, T0 and controlled profile patches.",
  "main": "./dist/host.mjs",
  "types": "./dist/host.d.mts",
  "bin": {
    "orbit": "./dist/cli.mjs",
    "orbit-t0": "./dist/t0.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/ui.d.mts",
      "import": "./dist/ui.mjs"
    },
    "./host": {
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./profiles/orbit-app.patch.yml": "./profiles/orbit-app.patch.yml",
    "./profiles/orbit-node.patch.yml": "./profiles/orbit-node.patch.yml",
    "./profiles/orbit-checker.patch.yml": "./profiles/orbit-checker.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "profiles"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@orbit/cli": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/dsh-host": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godokyang/orbit.git"
  },
  "license": "MIT"
}
